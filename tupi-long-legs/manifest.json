{
  "manifest_version": 3,
  "name": "Tupi LongLegs",
  "version": "1.0.0",
  "description": "Send your own timed, templated messages in Kick chat.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://kick.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Tupi LongLegs" },
  "content_scripts": [
    {
      "matches": ["https://kick.com/*"],
      "js": ["template.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
